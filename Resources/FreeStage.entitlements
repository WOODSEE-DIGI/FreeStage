<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: FreeStage is distributed outside the Mac App Store. -->
	<!-- Camera and microphone access require the Hardened Runtime entitlements -->
	<!-- below in addition to the Info.plist usage strings. -->

	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>

	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Allow loading third-party frameworks and dynamic libraries -->
	<!-- (Syphon.framework, libndi.dylib, etc.). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- Allow JIT if any rendering or scripting path needs it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- System extension installation for the virtual camera extension. -->
	<key>com.apple.security.system-extension.install</key>
	<true/>
</dict>
</plist>
