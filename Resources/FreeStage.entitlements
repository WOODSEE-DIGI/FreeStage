<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.microphone</key>
	<true/>
	<key>com.apple.security.screencapture</key>
	<true/>
	<key>com.apple.security.system-extension.install</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>info.v002.Syphon.*</string>
		<string>com.newtek.NDIAssistant</string>
	</array>
	<key>com.apple.security.temporary-exception.mach-register.global-name</key>
	<array>
		<string>info.v002.Syphon.*</string>
	</array>
	<key>com.apple.security.temporary-exception.distributed-notification.post</key>
	<array>
		<string>info.v002.Syphon.ServerAnnounce</string>
		<string>info.v002.Syphon.ServerRetire</string>
		<string>info.v002.Syphon.ServerUpdate</string>
	</array>
	<key>com.apple.security.temporary-exception.distributed-notification.register</key>
	<array>
		<string>info.v002.Syphon.ServerAnnounce</string>
		<string>info.v002.Syphon.ServerRetire</string>
		<string>info.v002.Syphon.ServerUpdate</string>
	</array>
</dict>
</plist>
