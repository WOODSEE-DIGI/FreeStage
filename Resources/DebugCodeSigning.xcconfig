// Debug code signing configuration.
//
// By default FreeStage Debug builds are ad-hoc signed. To use a stable
// self-signed identity so macOS TCC grants survive rebuilds, run:
//   ./scripts/setup-debug-signing.sh
// That script writes Resources/DebugCodeSigningLocal.xcconfig (gitignored)
// with the SHA-1 hash of the imported identity.

CODE_SIGN_IDENTITY = -
#include? "DebugCodeSigningLocal.xcconfig"
